{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yardstick",
  "version": "../package.json",
  "identifier": "construction.ridgeline.yardstick",
  "build": {
    "beforeDevCommand": "node update-src.js",
    "beforeBuildCommand": "node update-src.js",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Yardstick — PDF Markup & Plan Takeoff",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https: wss:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
