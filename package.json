{
  "name": "yardstick-desktop",
  "private": true,
  "version": "1.2.0",
  "scripts": {
    "update-src": "node update-src.js",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run update-src && npm test",
    "dev": "tauri dev",
    "build": "tauri build",
    "agent:dev": "wrangler dev --config agent/wrangler.jsonc",
    "agent:types": "wrangler types --config agent/wrangler.jsonc",
    "agent:check": "npm run agent:types && tsc --project agent/tsconfig.json",
    "agent:deploy": "wrangler deploy --config agent/wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@tauri-apps/cli": "^2",
    "agents": "^0.20.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.26.1"
  }
}
